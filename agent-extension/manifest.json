{
  "manifest_version": 3,
  "name": "Resume Agent · 当前标签页入口",
  "version": "0.7.29",
  "description": "通过网页表单维护简历资料，在普通 Chrome 当前招聘页进行语义映射、添加经历和填写核验；严禁自动提交。",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "dist/worker.js", "type": "module" },
  "options_ui": { "page": "profile-editor.html", "open_in_tab": true },
  "action": {
    "default_title": "Resume Agent：选择当前标签页",
    "default_popup": "popup.html"
  }
}
